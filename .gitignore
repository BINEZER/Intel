node_modules/
dist/
.next/
coverage/

# Firebase — never commit project linkage or service-account keys
.firebaserc
*-service-account*.json
serviceAccountKey.json
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Env — real secrets stay out, public Firebase config is committed.
.env
.env.*
!.env.example
!.env.production

# Import workbooks are INPUTS, not source. They carry real client names,
# contract values and phone numbers, and git history does not forget — so a
# workbook dropped in here to try an import stays out of the repository. No
# .xlsx has ever been tracked; this keeps it that way on purpose.
*.xlsx
*.xlsm

.DS_Store
