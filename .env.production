# Firebase web configuration for intel-afc60.
#
# COMMITTED ON PURPOSE. These six values are public by design: they ship inside
# the compiled website, so every visitor's browser already has them. They
# identify the project; they authorise nothing. What protects the data is
# firestore.rules — which is why those rules carry 53 tests.
#
# Shell environment variables override anything here, so a future production
# project can be pointed at from CI without touching this file.
VITE_FIREBASE_API_KEY=AIzaSyDLlK9Fpe02-babRKvte_AQNr6hujPXwxs
VITE_FIREBASE_AUTH_DOMAIN=intel-afc60.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=intel-afc60
VITE_FIREBASE_STORAGE_BUCKET=intel-afc60.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=901009380028
VITE_FIREBASE_APP_ID=1:901009380028:web:222e5d38b5a48153b5f6b9
VITE_USE_FIREBASE_EMULATORS=false
