# Copy to .env.local and fill from Firebase console > Project settings > Your apps.
# .env.local is gitignored. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=intel-afc60.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=intel-afc60
VITE_FIREBASE_STORAGE_BUCKET=intel-afc60.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the app at local emulators during development.
VITE_USE_FIREBASE_EMULATORS=true
