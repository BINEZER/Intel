rules_version = '2';

// IntelMotion PCM security rules.
//
// Roles come from a custom auth claim (`request.auth.token.role`) set by an
// admin-only Cloud Function, NOT from the users/{uid} document — reading a doc
// on every rule evaluation costs a billed read and can be raced.
//
// Financial integrity rule of thumb: engineers see projects, finance sees money,
// nobody deletes an issued invoice or a paid disbursement.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function role()      { return request.auth.token.get('role', 'none'); }
    function active()    { return request.auth.token.get('active', false) == true; }
    function has(roles)  { return signedIn() && active() && role() in roles; }

    function isAdmin()   { return has(['admin']); }
    function isFinance() { return has(['admin', 'finance']); }
    function isManager() { return has(['admin', 'manager']); }
    function canRead()   { return has(['admin', 'manager', 'finance', 'engineer', 'viewer']); }

    // Audit stamps must be truthful.
    function stampedCreate() {
      return request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
    }
    function stampedUpdate() {
      return request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy;
    }

    // Money must arrive as integer santim and reconcile before it is stored.
    function isSantim(v) { return v is int; }
    function vatReconciles(d) {
      return isSantim(d.valueNetSantim) && isSantim(d.vatSantim) && isSantim(d.valueGrossSantim)
          && d.valueGrossSantim == d.valueNetSantim + d.vatSantim;
    }
    function invoiceReconciles(d) {
      return isSantim(d.netSantim) && isSantim(d.vatSantim) && isSantim(d.grossSantim)
          && d.grossSantim == d.netSantim + d.vatSantim;
    }
    // WHT is charged on the VAT-exclusive base and deducted from the gross.
    function whtReconciles(d) {
      return isSantim(d.netSantim) && isSantim(d.supplierVatSantim) && isSantim(d.grossSantim)
          && isSantim(d.whtBaseSantim) && isSantim(d.whtSantim) && isSantim(d.netPayableSantim)
          && d.grossSantim == d.netSantim + d.supplierVatSantim
          && d.whtBaseSantim == d.netSantim
          && d.netPayableSantim == d.grossSantim - d.whtSantim;
    }

    // --- config: read by all, written only by admins -----------------------
    match /config/{docId} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }

    // --- users: self-read; role changes only via Cloud Function ------------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());

      // Self-provisioning on first sign-in. A new user has no role claim at all,
      // so requiring isAdmin() here would make the first profile uncreatable —
      // an admin cannot pre-create a document for a uid that does not exist yet.
      //
      // This is safe because the ROLE CLAIM is authoritative, not this document:
      // a self-created profile must claim no privileges, and grants nothing on
      // its own. An admin then activates the account and sets the real claim.
      allow create: if isAdmin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role == 'viewer'
                        && request.resource.data.active == false
                        && request.resource.data.email == request.auth.token.email);

      // A user may edit their own profile but never their own role or active flag.
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.active == resource.data.active);
      allow delete: if false; // deactivate instead, to preserve the audit trail
    }

    // --- counters: sequential document numbering ---------------------------
    // Invoice numbers must be sequential and gapless, so the sequence is bumped
    // inside a transaction. Finance and managers may consume a number; nobody
    // may set one to an arbitrary value, because rewinding the counter would
    // reuse an invoice number — a finding in any audit.
    match /counters/{counterId} {
      allow read:   if canRead();
      allow create: if (isFinance() || isManager()) && request.resource.data.value == 1;
      allow update: if (isFinance() || isManager())
                    && request.resource.data.value is int
                    && request.resource.data.value == resource.data.value + 1;
      // Never rewound — see above — but an admin may delete, so that a reset
      // restarts numbering from 1 instead of carrying yesterday's sequence
      // into a database with nothing in it.
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate();
      allow update: if isManager() && stampedUpdate();
      allow delete: if isAdmin();
    }

    match /subcontractors/{subId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate();
      allow update: if isManager() && stampedUpdate();
      allow delete: if isAdmin();
    }

    // --- contracts ---------------------------------------------------------
    match /contracts/{contractId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate() && vatReconciles(request.resource.data);
      allow update: if isManager() && stampedUpdate() && vatReconciles(request.resource.data);
      // An admin may delete a contract at any status, not only a draft. A bulk
      // import produces wrong contracts that are already 'active', and there
      // has to be a way to remove them. What protects the data is not the
      // status but the reference check the app runs first: a contract with
      // invoices or projects against it is refused there, with the reasons
      // named. This rule keeps the act to an admin.
      allow delete: if isAdmin();

      match /milestones/{milestoneId} {
        allow read:   if canRead();
        allow write:  if isManager() || isFinance();
      }
    }

    // --- projects ----------------------------------------------------------
    match /projects/{projectId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate();
      // Engineers may update progress but must not touch the financial rollup.
      allow update: if (isManager() && stampedUpdate())
                    || (has(['engineer']) && stampedUpdate()
                        && request.resource.data.financials == resource.data.financials);
      // As with contracts: the app refuses a project that has money against it,
      // and this rule keeps the act to an admin.
      allow delete: if isAdmin();

      match /phases/{phaseId} {
        allow read:   if canRead();
        allow create: if isManager() && stampedCreate();
        allow update: if has(['admin', 'manager', 'engineer']) && stampedUpdate();
        allow delete: if isManager();
      }
    }

    // --- units: the lifts themselves ---------------------------------------
    // Engineers may update a unit — status, remarks, the certificate they just
    // collected — because they are the people standing next to the machine.
    // Creating and deleting one is a manager's act: a unit is an identity that
    // callouts and contracts hang off, and a duplicate is worse than a gap.
    match /units/{unitId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate();
      allow update: if has(['admin', 'manager', 'engineer']) && stampedUpdate();
      // A lift entered by mistake should not have to be decommissioned first to
      // be removed. The app refuses one with callouts or visits against it.
      allow delete: if isAdmin();
    }

    // --- invoices: finance only; issued invoices are immutable -------------
    match /invoices/{invoiceId} {
      allow read:   if canRead();
      allow create: if isFinance() && stampedCreate() && invoiceReconciles(request.resource.data)
                    && request.resource.data.status == 'draft';
      // Once issued, only the payment fields and a void may change.
      allow update: if isFinance() && stampedUpdate() && invoiceReconciles(request.resource.data)
                    && (resource.data.status == 'draft'
                        || (request.resource.data.netSantim == resource.data.netSantim
                            && request.resource.data.vatSantim == resource.data.vatSantim
                            && request.resource.data.invoiceNo == resource.data.invoiceNo));
      // An admin may delete any invoice, not only a draft.
      //
      // The everyday rule — drafts only — is enforced in the app, by
      // `lib/deletion.ts`, which refuses an issued invoice by name and explains
      // why. That is where it belongs: it is a judgement about whether deleting
      // makes sense, and it can say so to the person holding the mouse.
      //
      // This rule is the outer fence, and it has to permit one thing the app
      // never offers: clearing the database back to empty. Without it a reset
      // leaves every issued invoice behind, which is not a reset. Authorised
      // deliberately; the audit log below still records who did it.
      allow delete: if isAdmin();

      // --- the chase: who asked, when the letter landed, what they promised --
      // Any signed-in role that works with clients may record a step, because
      // the person who made the call is the person who should write it down —
      // a chase log filled in second-hand by finance is a chase log nobody
      // trusts. Steps are never edited or deleted: the record of what was said
      // on a date is exactly the thing an escalation later rests on.
      match /collectionSteps/{stepId} {
        allow read:   if canRead();
        allow create: if has(['admin', 'manager', 'finance']) && stampedCreate();
        // Never edited: what was said on a date is the thing an escalation
        // later rests on. Deletable by an admin only so a reset does not strand
        // chase steps under an invoice that no longer exists.
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /receipts/{receiptId} {
        allow read:   if canRead();
        allow create: if isFinance();
        allow update: if isFinance();
        allow delete: if isAdmin();
      }
    }

    // --- disbursements: WHT must reconcile; paid vouchers are immutable ----
    match /disbursements/{disbursementId} {
      allow read:   if canRead();
      allow create: if isFinance() && stampedCreate() && whtReconciles(request.resource.data)
                    && request.resource.data.status == 'draft';
      allow update: if isFinance() && stampedUpdate() && whtReconciles(request.resource.data)
                    && resource.data.status != 'paid';
      // Drafts only on the everyday path, enforced in the app; an admin may
      // clear the collection so a reset leaves no vouchers behind. See the
      // note on invoices above.
      allow delete: if isAdmin();
    }

    // --- technicians -------------------------------------------------------
    match /technicians/{technicianId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate();
      allow update: if isManager() && stampedUpdate();
      // The app refuses this outright: `lib/deletion.ts` says a technician is
      // deactivated, never deleted, so the KPI history survives — and nothing
      // in the UI reaches past it. The rule admits an admin purely so a reset
      // can empty the collection.
      allow delete: if isAdmin();

      // KPI snapshots are computed server-side; nobody edits their own numbers.
      match /kpiSnapshots/{periodId} {
        allow read:  if canRead();
        allow create, update: if false;
        // An admin may delete, so a reset does not strand snapshots under a
        // technician who is no longer there. Still never written by hand.
        allow delete: if isAdmin();
      }
    }

    // --- project assignments -----------------------------------------------
    // Allocation drives how much of a project's team score each technician
    // carries, so only managers may set it.
    match /projectAssignments/{assignmentId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate();
      allow update: if isManager() && stampedUpdate();
      allow delete: if isManager();
    }

    // --- callouts ----------------------------------------------------------
    // Response and repair times drive technician SLA metrics, so the timestamps
    // they derive from must not be rewritten after the fact.
    function calloutTimesImmutable() {
      return request.resource.data.reportedAt == resource.data.reportedAt
          && (resource.data.arrivedAt == null
              || request.resource.data.arrivedAt == resource.data.arrivedAt)
          && (resource.data.resolvedAt == null
              || request.resource.data.resolvedAt == resource.data.resolvedAt);
    }

    match /callouts/{calloutId} {
      allow read:   if canRead();
      allow create: if has(['admin', 'manager', 'engineer']) && stampedCreate();
      // An engineer may progress a callout they are assigned; a manager, any.
      allow update: if stampedUpdate() && calloutTimesImmutable()
                    && (isManager()
                        || (has(['engineer'])
                            && resource.data.technicianId == request.auth.uid
                            && resource.data.status != 'resolved'));
      // Open callouts only on the everyday path — a resolved callout is the
      // evidence behind a response-time figure. An admin may clear them so a
      // reset empties the collection.
      allow delete: if isAdmin();
    }

    // --- maintenance visits ------------------------------------------------
    match /maintenanceVisits/{visitId} {
      allow read:   if canRead();
      allow create: if isManager() && stampedCreate();
      allow update: if stampedUpdate()
                    && (isManager()
                        || (has(['engineer'])
                            && resource.data.technicianId == request.auth.uid
                            // The promised date is the yardstick for PM
                            // compliance — a technician cannot move it.
                            && request.resource.data.scheduledDate == resource.data.scheduledDate));
      // A manager may drop a visit that has not happened yet; only an admin may
      // remove one already carried out, and only so a reset leaves no service
      // history behind an empty database.
      allow delete: if (isManager() && resource.data.status == 'scheduled') || isAdmin();
    }

    // --- Kanban ------------------------------------------------------------
    // Board documents themselves are manager-only: columns and WIP limits are
    // the board's structure, and everyone works inside it.
    //
    // There is deliberately NO `match /{document=**}` here. A recursive
    // wildcard matches ZERO or more segments, so a nested one intended for
    // subcollections also matches the board document — and because rules are a
    // permissive union, that silently handed every engineer write access to
    // the board itself. Cards live in the top-level `tasks` collection; any
    // future subcollection gets its own explicit match.
    match /boards/{boardId} {
      allow read:  if canRead();
      allow write: if isManager();
    }

    match /tasks/{taskId} {
      allow read:   if canRead();
      allow create: if has(['admin', 'manager', 'finance', 'engineer']) && stampedCreate();
      allow update: if has(['admin', 'manager', 'finance', 'engineer']) && stampedUpdate();
      allow delete: if isManager();
    }

    // --- archives: what is left of a job after it has been removed ----------
    // Written by an admin in the same batch that removes the job, and only ever
    // flipped from `removing` to `done` after that. It is the explanation for a
    // gap in the invoice numbering, so nobody rewrites it; an admin may delete
    // one only so that a reset leaves nothing behind.
    match /archives/{archiveId} {
      allow read:   if canRead();
      allow create: if isAdmin() && stampedCreate();
      allow update: if isAdmin() && stampedUpdate()
                    && resource.data.status == 'removing'
                    && request.resource.data.status == 'done'
                    && request.resource.data.contractId == resource.data.contractId
                    && request.resource.data.invoiceNumbers == resource.data.invoiceNumbers;
      allow delete: if isAdmin();
    }

    // --- audit log: append-only, never mutable ----------------------------
    match /auditLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
